@{
    Layout = null;

    // Breadcrumb için route bilgileri (örn: Admin / Deneyimler / DeneyimListesi)
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

}
<!DOCTYPE html>
<html lang="tr">
<head>   
    @await Component.InvokeAsync("_AdminLayoutHeadComponentPartial", new { pageTitle })
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")
    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>
    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">

        <!-- NAVBAR -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

        <!-- BREADCRUMB / URL -->
        <div class="page-header">
            <h1>@pageTitle</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    @if (!string.IsNullOrEmpty(area))
                    {
                        <li class="breadcrumb-item"><a href="/@area"><i class="bi bi-house-door me-1"></i>@area</a></li>
                    }
                    @if (!string.IsNullOrEmpty(controller))
                    {
                        <li class="breadcrumb-item">@controller</li>
                    }
                    @if (!string.IsNullOrEmpty(action))
                    {
                        <li class="breadcrumb-item active" aria-current="page">@action</li>
                    }
                </ol>
            </nav>
        </div>

        <!-- CONTENT -->
        <main class="main-body-container">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        @await Component.InvokeAsync("_AdminLayoutFooterComponentPartial")
    </div>

    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


