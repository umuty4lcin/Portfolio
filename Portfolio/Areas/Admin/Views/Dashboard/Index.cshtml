@model Portfolio.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // Ad soyaddan baş harfler (örn. "Ahmet Yılmaz" → "AY")
    string Initials(string? name) =>
        string.IsNullOrWhiteSpace(name)
            ? "?"
            : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => char.ToUpper(s[0])));
}

<style>
    .dash {
        font-family: "Segoe UI", Roboto, Arial, sans-serif;
        color: #1f2937;
        padding: 8px 4px 24px;
    }

        .dash * {
            box-sizing: border-box;
        }

    .dash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 24px;
    }

        .dash-header h1 {
            font-size: 26px;
            font-weight: 700;
            margin: 0;
        }

        .dash-header p {
            margin: 4px 0 0;
            color: #6b7280;
            font-size: 14px;
        }

    .dash-btn {
        background: #4f46e5;
        color: #fff;
        border: none;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
    }

        .dash-btn:hover {
            background: #4338ca;
            color: #fff;
        }

    .dash-grid {
        display: grid;
        gap: 20px;
    }

    .dash-stats {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        margin-bottom: 20px;
    }

    .dash-main {
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        margin-bottom: 20px;
    }

    .dash-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }

        .dash-card h3 {
            font-size: 16px;
            font-weight: 600;
            margin: 0 0 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .dash-card h3 a {
                font-size: 13px;
                font-weight: 500;
                color: #4f46e5;
                text-decoration: none;
            }

    .stat {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
        margin: 0;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        margin: 2px 0 0;
        line-height: 1.1;
    }

    .stat-sub {
        font-size: 12px;
        color: #9ca3af;
        margin-top: 4px;
    }

    .bg-indigo {
        background: #eef2ff;
        color: #4f46e5;
    }

    .bg-green {
        background: #ecfdf5;
        color: #059669;
    }

    .bg-amber {
        background: #fffbeb;
        color: #d97706;
    }

    .bg-sky {
        background: #f0f9ff;
        color: #0284c7;
    }

    .progress-row {
        margin-bottom: 18px;
    }

        .progress-row:last-child {
            margin-bottom: 0;
        }

    .progress-top {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-bottom: 6px;
    }

        .progress-top span:last-child {
            color: #6b7280;
        }

    .progress-bar {
        height: 10px;
        background: #f3f4f6;
        border-radius: 99px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 99px;
    }

    .fill-green {
        background: #10b981;
    }

    .fill-amber {
        background: #f59e0b;
    }

    .donut-wrap {
        display: flex;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
    }

    .donut {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .donut-inner {
        width: 96px;
        height: 96px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .donut-inner strong {
            font-size: 22px;
        }

        .donut-inner small {
            font-size: 11px;
            color: #6b7280;
        }

    .legend {
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 14px;
    }

        .legend li {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }

        .legend i {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            display: inline-block;
        }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .dash-table th {
            text-align: left;
            font-weight: 600;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 10px 12px;
            border-bottom: 1px solid #e5e7eb;
            background: #f9fafb;
        }

        .dash-table td {
            padding: 12px;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: middle;
        }

        .dash-table tr:last-child td {
            border-bottom: none;
        }

        .dash-table tr:hover td {
            background: #fafafa;
        }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e0e7ff;
        color: #4338ca;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 13px;
        margin-right: 10px;
    }

    .name-cell {
        display: flex;
        align-items: center;
    }

    .muted {
        color: #6b7280;
        font-size: 13px;
    }

    .dash-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 600;
    }

    .dash-badge-read {
        background: #ecfdf5;
        color: #047857;
    }

    .dash-badge-unread {
        background: #fef3c7;
        color: #b45309;
    }

    .table-scroll {
        overflow-x: auto;
    }

    .activity {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .activity li {
            display: flex;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #f3f4f6;
            font-size: 14px;
        }

            .activity li:last-child {
                border-bottom: none;
            }

    .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-top: 6px;
        flex-shrink: 0;
    }

    .activity .time {
        font-size: 12px;
        color: #9ca3af;
        display: block;
        margin-top: 2px;
    }

    .quick-links {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

        .quick-links a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            color: #1f2937;
            text-decoration: none;
            font-size: 14px;
        }

            .quick-links a:hover {
                border-color: #4f46e5;
                background: #f5f7ff;
            }

    /* ========== DARK MODE ========== */
    [data-bs-theme="dark"] .dash { color: #E6EAF5; }
    [data-bs-theme="dark"] .dash-header p,
    [data-bs-theme="dark"] .stat-label,
    [data-bs-theme="dark"] .progress-top span:last-child,
    [data-bs-theme="dark"] .donut-inner small,
    [data-bs-theme="dark"] .dash-table th,
    [data-bs-theme="dark"] .muted { color: #A3AEC4; }
    [data-bs-theme="dark"] .stat-sub,
    [data-bs-theme="dark"] .activity .time { color: #8590A8; }

    [data-bs-theme="dark"] .dash-card,
    [data-bs-theme="dark"] .donut-inner { background: #1B2136; border-color: #2A3150; box-shadow: none; }
    [data-bs-theme="dark"] .dash-card h3 a { color: #A99CFA; }

    [data-bs-theme="dark"] .bg-indigo { background: #2B2556; color: #A99CFA; }
    [data-bs-theme="dark"] .bg-green { background: #14301F; color: #4FD18B; }
    [data-bs-theme="dark"] .bg-amber { background: #3A2E12; color: #F5B84B; }
    [data-bs-theme="dark"] .bg-sky { background: #14304A; color: #6FB9F2; }

    [data-bs-theme="dark"] .progress-bar { background: #2A3150; }
    [data-bs-theme="dark"] .dash-table th { background: #232A44; border-bottom-color: #2A3150; }
    [data-bs-theme="dark"] .dash-table td { border-bottom-color: #2A3150; }
    [data-bs-theme="dark"] .dash-table tr:hover td { background: #212842; }
    [data-bs-theme="dark"] .activity li { border-bottom-color: #2A3150; }

    [data-bs-theme="dark"] .avatar { background: #2B2556; color: #A99CFA; }
    [data-bs-theme="dark"] .dash-badge-read { background: #14301F; color: #4FD18B; }
    [data-bs-theme="dark"] .dash-badge-unread { background: #3A2E12; color: #F5B84B; }

    [data-bs-theme="dark"] .quick-links a { border-color: #2A3150; color: #E6EAF5; }
    [data-bs-theme="dark"] .quick-links a:hover { border-color: #A99CFA; background: #212842; }
</style>

<div class="dash">

    <!-- Başlık -->
    <div class="dash-header">
        <div>
            <p>Hoş geldiniz! Portfolyo sitenizin genel durumu aşağıda.</p>
        </div>
        
    </div>

    <!-- İstatistik kartları -->
    <div class="dash-grid dash-stats">
        <div class="dash-card stat">
            <div class="stat-icon bg-indigo">✉</div>
            <div>
                <p class="stat-label">Toplam Mesaj</p>
                <p class="stat-value">@Model.TotalMessages</p>
                <div class="stat-sub">Tüm zamanlar</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-green">✔</div>
            <div>
                <p class="stat-label">Okunmuş Mesaj</p>
                <p class="stat-value">@Model.ReadMessages</p>
                <div class="stat-sub">%@Model.ReadPercent oranında</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-amber">●</div>
            <div>
                <p class="stat-label">Okunmamış Mesaj</p>
                <p class="stat-value">@Model.UnreadMessages</p>
                <div class="stat-sub">%@Model.UnreadPercent oranında</div>
            </div>
        </div>
        <div class="dash-card stat">
            <div class="stat-icon bg-sky">📁</div>
            <div>
                <p class="stat-label">Toplam Proje</p>
                <p class="stat-value">@Model.TotalProjects</p>
                <div class="stat-sub">@Model.ActiveProjects aktif proje</div>
            </div>
        </div>
    </div>

    <!-- Mesaj durumu + Grafik -->
    <div class="dash-grid dash-main">
        <div class="dash-card">
            <h3>Mesaj Durumu</h3>
            <div class="progress-row">
                <div class="progress-top"><span>Okunmuş</span><span>@Model.ReadMessages / @Model.TotalMessages</span></div>
                <div class="progress-bar"><div class="progress-fill fill-green" style="width:@(Model.ReadPercent)%"></div></div>
            </div>
            <div class="progress-row">
                <div class="progress-top"><span>Okunmamış</span><span>@Model.UnreadMessages / @Model.TotalMessages</span></div>
                <div class="progress-bar"><div class="progress-fill fill-amber" style="width:@(Model.UnreadPercent)%"></div></div>
            </div>
        </div>

        <div class="dash-card">
            <h3>Okunma Oranı</h3>
            <div class="donut-wrap">
                <div class="donut" style="background: conic-gradient(#10b981 0 @(Model.ReadPercent)%, #f59e0b @(Model.ReadPercent)% 100%);">
                    <div class="donut-inner">
                        <strong>%@Model.ReadPercent</strong>
                        <small>okundu</small>
                    </div>
                </div>
                <ul class="legend">
                    <li><i style="background:#10b981"></i> Okunmuş (@Model.ReadMessages)</li>
                    <li><i style="background:#f59e0b"></i> Okunmamış (@Model.UnreadMessages)</li>
                    <li><i style="background:#4f46e5"></i> Toplam (@Model.TotalMessages)</li>
                </ul>
            </div>
        </div>
    </div>
    <!-- Hızlı mesaj listesi (statik) -->
    <div class="dash-card" style="margin-bottom:20px;">
        <h3>Son Mesajlar <a href="/Admin/Message/MessageList">Tümünü gör →</a></h3>
        <div class="table-scroll">
            <table class="dash-table">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.LastMessages)
                    {
                        <tr>
                            <td>
                                <div class="name-cell">
                                    <span class="avatar">@Initials(m.NameSurname)</span>
                                    <div>@m.NameSurname<div class="muted">@m.Email</div></div>
                                </div>
                            </td>
                            <td>@m.Subject</td>
                            <td class="muted">@m.SendDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (m.IsRead) { <span class="dash-badge dash-badge-read">Okundu</span> }
                                else { <span class="dash-badge dash-badge-unread">Okunmadı</span> }
                            </td>
                        </tr>
                    }
                    @if (!Model.LastMessages.Any())
                    {
                        <tr><td colspan="4" class="muted text-center py-4">Henüz mesaj yok.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
        <div class="dash-grid dash-main">
        <div class="dash-card">
            <h3>Kategorilere Göre Projeler <span class="muted">@Model.TotalProjects Proje - @Model.TotalCategories kategori</span></h3>
            
            @foreach (var c in Model.CategoryStats)
            {
                int yuzde = Model.TotalProjects > 0 ? (int)Math.Round(c.ProjectCount * 100.0 / Model.TotalProjects) : 0;
                <div class="progress-row">
                    <div class="progress-top"><span>@c.CategoryName</span><span>@c.ProjectCount proje</span></div>
                    <div class="progress-bar"><div class="progress-fill fill-green" style="width:@(yuzde)%"></div></div>
                </div>
            }
            @if (!Model.CategoryStats.Any())
            {
                <div class="muted">Henüz proje yok.</div>
            }
        </div>
    </div>
    <div class="dash-grid dash-main">
        <div class="dash-card">
            <h3>Son Projeler <a href="/Admin/Project/ProjectList">Tümünü gör →</a></h3>
            <ul class="activity">
                @foreach (var p in Model.LastProjects)
                {
                    <li>
                        <span class="dot" style="background:#4f46e5"></span>
                        <div>
                            <b>@p.Title</b>
                            <span class="time">@p.Category?.CategoryName @(p.IsActive ? "• Aktif" : "• Pasif")</span>
                        </div>
                    </li>
                }
                @if (!Model.LastProjects.Any())
                {
                    <li class="muted">Henüz proje yok.</li>
                }
            </ul>
        </div>

        <div class="dash-card">
            <h3>Hızlı Erişim</h3>
            <div class="quick-links">
                <a href="/Admin/Project/CreateProject">📁 Proje Ekle</a>
                <a href="/Admin/Message/MessageList">✉ Tüm Mesajlar</a>
                <a href="/Admin/About/AboutList">👤 Hakkımda</a>
                <a href="/" target="_blank">🌐 Siteyi Görüntüle</a>
            </div>
        </div>
    </div>

</div>


