@model Portfolio.Entities.HeroSection
@{
    ViewData["Title"] = "Hero Bölümü";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Hero Bölümü</h2>
            <p class="ui-card-sub">Ana sayfanın en üstündeki karşılama alanını buradan güncelleyin.</p>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="HeroSectionId" />

        <div class="ui-card-body">
            <div class="row g-4">

                <!-- Sol: Metinler -->
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label class="ui-label" for="Title">Rozet Metni</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-emoji-smile"></i></span>
                            <input type="text" class="form-control" asp-for="Title" placeholder="Bilgisayar Mühendisi & Full Stack Developer" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                        <div class="ui-hint">Başlığın üstündeki küçük rozette görünür.</div>
                    </div>

                    <div class="mb-3">
                        <label class="ui-label" for="SubTitle">Ad Soyad</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" class="form-control" asp-for="SubTitle" placeholder="Umut Yalçın" />
                        </div>
                        <span asp-validation-for="SubTitle" class="text-danger small"></span>
                        <div class="ui-hint">"Merhaba, Ben ..." başlığında renkli görünür.</div>
                    </div>

                    <div class="mb-3">
                        <label class="ui-label" for="Description">Açıklama</label>
                        <textarea class="form-control" asp-for="Description" rows="6"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Sağ: Görsel -->
                <div class="col-lg-4">
                    <label class="ui-label" for="heroImage">Portre Görseli</label>
                    <div class="mb-2 rounded-3 border d-flex align-items-center justify-content-center overflow-hidden"
                         style="aspect-ratio: 4/5; background: var(--surface-alt);">
                        <img id="heroPreview" alt="Önizleme" style="width:100%; height:100%; object-fit:cover;"
                             class="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "d-none" : "")"
                             src="@Model.ImageUrl" />
                        <span id="heroPlaceholder" class="text-muted small @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "" : "d-none")">
                            <i class="bi bi-image me-1"></i> Önizleme
                        </span>
                    </div>
                    <input type="file" class="form-control" id="heroImage" name="heroImage" accept=".jpg,.jpeg,.png" />
                    @if (ViewBag.ImageError != null)
                    {
                        <div class="text-danger small mt-1">@ViewBag.ImageError</div>
                    }
                    <div class="ui-hint">jpg, png veya jpeg, en fazla 2 MB. Seçmezseniz mevcut görsel korunur.</div>
                </div>

            </div>
        </div>

        <div class="ui-card-footer">
            <button type="submit" class="ui-btn ui-btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('heroImage').addEventListener('change', function () {
            const file = this.files[0];
            const img = document.getElementById('heroPreview');
            const placeholder = document.getElementById('heroPlaceholder');

            if (file) {
                img.src = URL.createObjectURL(file);
                img.classList.remove('d-none');
                placeholder.classList.add('d-none');
            }
        });
    </script>
}
