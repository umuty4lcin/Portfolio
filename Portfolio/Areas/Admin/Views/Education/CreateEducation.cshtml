@model Portfolio.Entities.Education
@{
    ViewData["Title"] = "Yeni Eğitim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Yeni Eğitim Ekle</h2>
            <p class="ui-card-sub">Ana sayfadaki zaman çizelgesinde görünecek yeni bir eğitim kaydı oluşturun.</p>
        </div>
    </div>

    <form method="post">
        <div class="ui-card-body">
            <div class="row g-4">

                <div class="col-lg-5">
                    <div class="mb-3">
                        <label class="ui-label" for="Title">Okul / Kurum</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building"></i></span>
                            <input type="text" class="form-control" asp-for="Title" placeholder="Marmara Üniversitesi" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="ui-label" for="SubTitle">Bölüm / Program</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-journal-bookmark"></i></span>
                            <input type="text" class="form-control" asp-for="SubTitle" placeholder="Bilgisayar Mühendisliği — Lisans" />
                        </div>
                        <span asp-validation-for="SubTitle" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="ui-label" for="Duration">Dönem</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
                            <input type="text" class="form-control" asp-for="Duration" placeholder="2020 – 2024" />
                        </div>
                        <span asp-validation-for="Duration" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive"/>
                        <label class="form-check-label" for="IsActive">Aktif (ana sayfada göster)</label>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="mb-3">
                        <label class="ui-label" for="Description">Açıklama</label>
                        <textarea class="form-control" asp-for="Description" rows="9"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

            </div>
        </div>

        <div class="ui-card-footer">
            <button type="submit" class="ui-btn ui-btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
            <a href="/Admin/Education/EducationList" class="ui-btn ui-btn-light">Vazgeç</a>
        </div>
    </form>
</div>