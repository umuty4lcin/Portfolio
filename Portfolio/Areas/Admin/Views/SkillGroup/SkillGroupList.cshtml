@model List<Portfolio.Entities.SkillGroup>
@{
    ViewData["Title"] = "Yetenek Grupları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    string Short(string? text, int max) =>
        string.IsNullOrEmpty(text) ? "" : (text.Length <= max ? text : text.Substring(0, max).TrimEnd() + "...");
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Yetenek Grupları <span class="ui-count">@Model.Count kayıt</span></h2>
            <p class="ui-card-sub">Ana sayfadaki "Yeteneklerim" bölümünde görünen grup kartlarını buradan yönetebilirsiniz.</p>
        </div>
        <a href="/Admin/SkillGroup/CreateSkillGroup" class="ui-btn ui-btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Grup
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th style="width: 70px;">İkon</th>
                        <th>Grup Adı</th>
                        <th>Açıklama</th>
                        <th>Yetenek</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="ui-id">@item.SkillGroupId</span></td>
                            <td>
                                <div class="float-icon-box @item.ColorClass" style="width:40px;height:40px;font-size:1.1rem;">
                                    <i class="bi @item.IconClass"></i>
                                </div>
                            </td>
                            <td class="fw-semibold">@item.Title</td>
                            <td style="max-width: 280px;">
                                <span data-bs-toggle="tooltip" data-bs-title="@item.Description">@Short(item.Description, 50)</span>
                            </td>
                            <td><span class="ui-count">@item.Skills.Count adet</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="ui-badge ui-badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="ui-badge ui-badge-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="ui-actions">
                                    <a href="/Admin/SkillGroup/UpdateSkillGroup/@item.SkillGroupId" class="ui-btn ui-icon-btn edit" title="Düzenle" aria-label="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/SkillGroup/DeleteSkillGroup/@item.SkillGroupId" class="ui-btn ui-icon-btn delete js-delete"
                                       data-confirm="Bu yetenek grubu kalıcı olarak silinecek."
                                       title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ui-empty">
            <i class="bi bi-collection"></i>
            <div class="fw-semibold mb-1">Henüz yetenek grubu eklenmemiş</div>
            <div class="small">Başlamak için "Yeni Grup" butonunu kullanın.</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
    </script>
}