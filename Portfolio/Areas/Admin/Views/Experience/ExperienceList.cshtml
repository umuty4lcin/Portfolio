@model List<Portfolio.Entities.Experience>
@{
    ViewData["Title"] = "Deneyimler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Deneyim Listesi <span class="ui-count">@Model.Count kayıt</span></h2>
            <p class="ui-card-sub">Ana sayfadaki "Deneyimlerim" bölümünde görünen kayıtları buradan yönetebilirsiniz.</p>
        </div>
        <a href="/Admin/Experience/CreateExperience" class="ui-btn ui-btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Deneyim
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Pozisyon</th>
                        <th>Şirket</th>
                        <th>Dönem</th>
                        <th>Tür</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="ui-id">@item.ExperienceId</span></td>
                            <td class="fw-semibold">@item.Title</td>
                            <td>@item.CompanyName</td>
                            <td class="text-nowrap">@item.DurationText</td>
                            <td><span class="ui-badge">@item.WorkType</span></td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="ui-badge ui-badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="ui-badge ui-badge-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="ui-actions">
                                    <a href="/Admin/Experience/UpdateExperience/@item.ExperienceId" class="ui-btn ui-icon-btn edit" title="Düzenle" aria-label="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Experience/DeleteExperience/@item.ExperienceId" class="ui-btn ui-icon-btn delete js-delete"
                                       data-confirm="Bu deneyim kaydı kalıcı olarak silinecek."
                                       title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ui-empty">
            <i class="bi bi-briefcase"></i>
            <div class="fw-semibold mb-1">Henüz deneyim eklenmemiş</div>
            <div class="small">Başlamak için "Yeni Deneyim" butonunu kullanın.</div>
        </div>
    }
</div>