@model Portfolio.Entities.Project
@{
    ViewData["Title"] = "Projeyi Düzenle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    bool gorselVar = !string.IsNullOrEmpty(Model.CoverImageUrl);
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Projeyi Düzenle</h2>
            <p class="ui-card-sub">Yeni görsel seçmezseniz mevcut görsel korunur.</p>
        </div>
    </div>

    <form method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ProjectId" />

        <div class="ui-card-body">
            <div class="row g-4">

                <!-- Sol: Bilgiler -->
                <div class="col-lg-8">
                    <div class="mb-3">
                        <label class="ui-label" for="Title">Proje Adı</label>
                        <input type="text" class="form-control" asp-for="Title" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="ui-label" for="CategoryId">Kategori</label>
                            <select class="form-select" asp-for="CategoryId" asp-items="@((SelectList)ViewBag.Categories)" required>
                                <option value="">Kategori seçin</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="ui-label" for="GithubUrl">GitHub Adresi</label>
                            <input type="url" class="form-control" asp-for="GithubUrl" placeholder="https://github.com/..." required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="ui-label" for="Description">Açıklama</label>
                        <textarea class="form-control" asp-for="Description" rows="8" required></textarea>
                    </div>
                </div>

                <!-- Sağ: Görsel + Durum -->
                <div class="col-lg-4">
                    <label class="ui-label" for="coverImage">Kapak Görseli</label>
                    <div class="mb-2 rounded-3 border d-flex align-items-center justify-content-center overflow-hidden"
                         style="aspect-ratio: 16/9; background: #f8f9fc;">
                        <img id="coverPreview" src="@Model.CoverImageUrl" alt="@Model.Title"
                             class="@(gorselVar ? "" : "d-none")" style="width:100%; height:100%; object-fit:cover;" />
                        <span id="coverPlaceholder" class="text-muted small @(gorselVar ? "d-none" : "")">
                            <i class="bi bi-image me-1"></i> Görsel yok
                        </span>
                    </div>
                    <input type="file" class="form-control" id="coverImage" name="coverImage" accept=".jpg,.jpeg,.png" />
                    @if (ViewBag.ImageError != null)
                    {
                        <div class="text-danger small mt-1">@ViewBag.ImageError</div>
                    }
                    <div class="ui-hint">Opsiyonel. jpg, png veya jpeg, en fazla 2 MB.</div>

                    <div class="form-check form-switch mt-4">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                        <label class="form-check-label" for="IsActive">Aktif (portfolyoda göster)</label>
                    </div>
                </div>

            </div>
        </div>

        <div class="ui-card-footer">
            <button type="submit" class="ui-btn ui-btn-primary"><i class="bi bi-check-lg"></i> Güncelle</button>
            <a href="/Admin/Project/ProjectList" class="ui-btn ui-btn-light">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const preview = document.getElementById('coverPreview');
        const placeholder = document.getElementById('coverPlaceholder');
        const mevcutGorsel = preview.getAttribute('src');   // sunucudan gelen mevcut görsel

        document.getElementById('coverImage').addEventListener('change', function () {
            const file = this.files[0];

            if (file) {
                // Yeni dosya seçildi: onu önizle
                preview.src = URL.createObjectURL(file);
                preview.classList.remove('d-none');
                placeholder.classList.add('d-none');
            } else if (mevcutGorsel) {
                // Seçim iptal edildi: mevcut görsele dön
                preview.src = mevcutGorsel;
            } else {
                preview.classList.add('d-none');
                placeholder.classList.remove('d-none');
            }
        });
    </script>
}