@model List<Portfolio.Entities.Project>
@{
    ViewData["Title"] = "Projeler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    string Short(string? text, int max) =>
        string.IsNullOrEmpty(text) ? "" : (text.Length <= max ? text : text.Substring(0, max).TrimEnd() + "...");
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Proje Listesi <span class="ui-count">@Model.Count kayıt</span></h2>
            <p class="ui-card-sub">Portfolyonuzda gösterilen projeleri buradan yönetebilirsiniz.</p>
        </div>
        <a href="/Admin/Project/CreateProject" class="ui-btn ui-btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Proje
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th style="width: 90px;">#</th>
                        <th>Görsel</th>
                        <th>Proje Adı</th>
                        <th>Açıklama</th>
                        <th>Kategori</th>
                        <th>GitHub</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="ui-id">@item.ProjectId</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                {
                                    <img src="@item.CoverImageUrl" alt="@item.Title" class="ui-thumb" loading="lazy"
                                         onerror="this.style.visibility='hidden'" />
                                }
                            </td>
                            <td class="fw-semibold">@item.Title</td>
                            <td style="max-width: 280px;">
                                <span data-bs-toggle="tooltip" data-bs-title="@item.Description">@Short(item.Description, 45)</span>
                            </td>
                            <td>
                                @if (item.Category != null)
                                {
                                    <span class="ui-count" style="margin-left: 0;">@item.Category.CategoryName</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener" class="ui-link">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="ui-badge ui-badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="ui-badge ui-badge-danger">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="ui-actions">
                                    <a href="/Admin/Project/UpdateProject/@item.ProjectId" class="ui-btn ui-icon-btn edit" title="Düzenle" aria-label="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Project/DeleteProject/@item.ProjectId"
                                       class="ui-btn ui-icon-btn delete js-delete"
                                       data-confirm="Bu proje ve görseli kalıcı olarak silinecek."
                                       title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ui-empty">
            <i class="bi bi-grid"></i>
            <div class="fw-semibold mb-1">Henüz proje eklenmemiş</div>
            <div class="small">Başlamak için "Yeni Proje" butonunu kullanın.</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));
    </script>
}
