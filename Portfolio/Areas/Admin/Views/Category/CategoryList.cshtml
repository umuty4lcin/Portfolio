@model List<Portfolio.Entities.Category>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show ui-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<div class="ui-card">
    <div class="ui-card-header">
        <div>
            <h2 class="ui-card-title">Kategori Listesi <span class="ui-count">@Model.Count kayıt</span></h2>
            <p class="ui-card-sub">Projelerinizi gruplamak için kullandığınız kategoriler.</p>
        </div>
        <a href="/Admin/Category/CreateCategory" class="ui-btn ui-btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Kategori
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="ui-table">
                <thead>
                    <tr>
                        <th style="width: 90px;">#</th>
                        <th>Kategori Adı</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="ui-id">@item.CategoryId</span></td>
                            <td class="fw-semibold">@item.CategoryName</td>
                            <td>
                                <div class="ui-actions">
                                    <a href="/Admin/Category/UpdateCategory/@item.CategoryId" class="ui-btn ui-icon-btn edit" title="Düzenle" aria-label="Düzenle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="/Admin/Category/DeleteCategory/@item.CategoryId"
                                        class="ui-btn ui-icon-btn delete js-delete"
                                        data-confirm="Bu kategori kalıcı olarak silinecek."
                                        title="Sil" aria-label="Sil">
                                        <i class="bi bi-trash3"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="ui-empty">
            <i class="bi bi-tags"></i>
            <div class="fw-semibold mb-1">Henüz kategori eklenmemiş</div>
            <div class="small">Başlamak için "Yeni Kategori" butonunu kullanın.</div>
        </div>
    }
</div>
