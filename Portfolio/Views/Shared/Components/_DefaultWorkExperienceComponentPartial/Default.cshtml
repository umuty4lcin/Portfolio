@model List<Portfolio.Entities.Experience>

<!-- Work Experience Section -->
<section id="experience">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">PROFESYONEL YOLCULUK</span>
            <h2 class="section-title">Deneyimlerim</h2>
            <p class="section-subtitle">Gerçek dünya problemlerini çözerken edindiğim tecrübeler.</p>
        </div>

        <div class="timeline-container">
            @for (int i = 0; i < Model.Count; i++)
            {
                var e = Model[i];
                bool kartSolda = i % 2 == 0;

                string[] rozetRenkleri = { "bg-icon-purple", "bg-icon-blue", "bg-icon-peach" };
                string[] ikonlar = { "bi-building", "bi-pc-display", "bi-award" };
                string rozetRenk = rozetRenkleri[i % 3];
                string ikon = ikonlar[i % 3];

                string turRenk = e.WorkType switch
                {
                    "Tam Zamanlı" => "bg-success-subtle text-success border-success-subtle",
                    "Yarı Zamanlı" => "bg-primary-subtle text-primary border-primary-subtle",
                    "Staj" => "bg-warning-subtle text-warning border-warning-subtle",
                    _ => "bg-secondary-subtle text-secondary border-secondary-subtle"
                };

                var maddeler = e.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                var teknolojiler = (e.Technologies ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                    @if (kartSolda)
                    {
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">
                            <div class="timeline-content-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge-year @rozetRenk">
                                        <i class="bi bi-briefcase"></i> @e.DurationText
                                    </span>
                                    <span class="badge @turRenk border rounded-pill px-3 py-1 small">@e.WorkType</span>
                                </div>
                                <h4 class="fs-5 fw-bold mb-1">@e.Title</h4>
                                <div class="text-primary fw-semibold small mb-3">@e.CompanyName</div>
                                <ul class="text-secondary small ps-3 mb-3" style="line-height: 1.6;">
                                    @foreach (var madde in maddeler)
                                    {
                                        <li>@madde</li>
                                    }
                                </ul>
                                <div>
                                    @foreach (var tech in teknolojiler)
                                    {
                                        <span class="tech-tag">@tech</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="timeline-marker">
                            <i class="bi @ikon"></i>
                        </div>
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@e.SideTitle</div>
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-6 timeline-left d-none d-lg-block">
                            <div class="text-secondary small fst-italic">@e.SideTitle</div>
                        </div>
                        <div class="timeline-marker">
                            <i class="bi @ikon"></i>
                        </div>
                        <div class="col-lg-6 timeline-right">
                            <div class="timeline-content-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge-year @rozetRenk">
                                        <i class="bi bi-briefcase"></i> @e.DurationText
                                    </span>
                                    <span class="badge @turRenk border rounded-pill px-3 py-1 small">@e.WorkType</span>
                                </div>
                                <h4 class="fs-5 fw-bold mb-1">@e.Title</h4>
                                <div class="text-primary fw-semibold small mb-3">@e.CompanyName</div>
                                <ul class="text-secondary small ps-3 mb-3" style="line-height: 1.6;">
                                    @foreach (var madde in maddeler)
                                    {
                                        <li>@madde</li>
                                    }
                                </ul>
                                <div>
                                    @foreach (var tech in teknolojiler)
                                    {
                                        <span class="tech-tag">@tech</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>