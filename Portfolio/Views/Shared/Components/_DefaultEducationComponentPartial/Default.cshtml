@model List<Portfolio.Entities.Education>

<!-- Education Section -->
<section id="education" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">AKADEMİK YOLCULUĞUM</span>
            <h2 class="section-title">Eğitim Hayatım</h2>
            <p class="section-subtitle">Yazılım dünyasına uzanan yolculuğumun akademik temelleri.</p>
        </div>

        <div class="timeline-container">
            @for (int i = 0; i < Model.Count; i++)
            {
                var e = Model[i];
                bool kartSolda = i % 2 == 0;
                string rozetRenk = kartSolda ? "bg-icon-purple" : "bg-icon-mint";
                string ikon = kartSolda ? "bi-mortarboard" : "bi-book";

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">
                    @if (kartSolda)
                    {
                        <div class="col-lg-6 timeline-left order-2 order-lg-1">
                            <div class="timeline-content-card">
                                <span class="badge-year @rozetRenk mb-2">
                                    <i class="bi bi-calendar3"></i> @e.Duration
                                </span>
                                <h4 class="fs-5 fw-bold mb-1">@e.Title</h4>
                                <div class="text-primary fw-semibold small mb-2">@e.SubTitle</div>
                                <p class="text-secondary small mb-0">@e.Description</p>
                            </div>
                        </div>
                        <div class="timeline-marker">
                            <i class="bi @ikon"></i>
                        </div>
                        <div class="col-lg-6 timeline-right order-1 order-lg-2 d-none d-lg-block"></div>
                    }
                    else
                    {
                        <div class="col-lg-6 timeline-left d-none d-lg-block"></div>
                        <div class="timeline-marker">
                            <i class="bi @ikon"></i>
                        </div>
                        <div class="col-lg-6 timeline-right">
                            <div class="timeline-content-card">
                                <span class="badge-year @rozetRenk mb-2">
                                    <i class="bi bi-calendar3"></i> @e.Duration
                                </span>
                                <h4 class="fs-5 fw-bold mb-1">@e.Title</h4>
                                <div class="text-primary fw-semibold small mb-2">@e.SubTitle</div>
                                <p class="text-secondary small mb-0">@e.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>