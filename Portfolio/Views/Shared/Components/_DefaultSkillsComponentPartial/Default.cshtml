@model List<Portfolio.Entities.SkillGroup>

<!-- Technical Skills Section -->
<section id="skills" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">TEKNİK YETKİNLİKLER</span>
            <h2 class="section-title">Yeteneklerim</h2>
            <p class="section-subtitle">Fikirleri çalışan yazılımlara dönüştürürken kullandığım teknolojiler.</p>
        </div>

        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var group = Model[i];

                // İlk 3 kart 3'lü, kalanlar 2'li dizilir (eski tasarımdaki düzen)
                string colClass = i < 3 ? "col-lg-4 col-md-6" : "col-lg-6 col-md-6";

                <div class="@colClass reveal-on-scroll">
                    <div class="skill-group-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="float-icon-box @group.ColorClass">
                                <i class="bi @group.IconClass"></i>
                            </div>
                            <h4 class="fs-5 fw-bold mb-0">@group.Title</h4>
                        </div>
                        <p class="text-secondary small mb-3">@group.Description</p>
                        <div class="d-flex flex-wrap">
                            @foreach (var skill in group.Skills)
                            {
                                <span class="skill-chip" data-bs-toggle="tooltip" data-bs-title="Seviye: %@skill.Level">
                                    <i class="bi bi-check text-success"></i> @skill.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>