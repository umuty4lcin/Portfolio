@model List<string>

<!-- Infinite Soft Marquee for Technologies -->
@if (Model.Any())
{
    <div class="marquee-container">
        <div class="marquee-track">
            @* Kesintisiz döngü için liste iki kez yazdırılır *@
            @for (int round = 0; round < 2; round++)
            {
                @foreach (var name in Model)
                {
                    <div class="marquee-item"><i class="bi bi-check2-circle"></i> @name</div>
                }
            }
        </div>
    </div>
}